# Copy to .env and fill in. Load with: set -a; source .env; set +a
# (or use python-dotenv). Only the keys for providers you actually use matter.

OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Providers (defaults shown) ---
LLM_PROVIDER=openai          # openai | anthropic   (pipeline answerer)
JUDGE_PROVIDER=openai        # openai | anthropic   (metric scorer)
EMBED_PROVIDER=openai        # openai | local

# --- Models (sensible defaults are chosen per-provider in config.py) ---
# GEN_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# --- Retrieval knobs (change these and watch the retrieval metrics move) ---
TOP_K=3

# --- Thresholds for the CI gate ---
# THR_FAITHFULNESS=0.80
# THR_ANSWER_RELEVANCY=0.75
# THR_CONTEXT_PRECISION=0.70
# THR_CONTEXT_RECALL=0.70
